#include <iostream>
#include <fstream>
#include <string>
#include <limits>

using namespace std;

// Vigenere-style Cipher Encryption using a string key
string Encrypt(string text, string userkey) {
    if (userkey.empty()) return text;
    for (size_t i = 0; i < text.length(); i++) {
        text[i] = text[i] + userkey[i % userkey.length()];
    }
    return text;
}

// Vigenere-style Cipher Decryption using a string key
string Decrypt(string text, string userkey) {
    if (userkey.empty()) return text;
    for (size_t i = 0; i < text.length(); i++) {
        text[i] = text[i] - userkey[i % userkey.length()];
    }
    return text;
}

class User {
private:
    string activeUsername;

public:
    void registerUser() {
        ofstream file("user.txt", ios::app);
        string username, password;

        cout << "\n--- Registration ---\n";
        cout << "Enter username (no spaces): ";
        cin >> username;
        cout << "Enter password: ";
        cin >> password;

        file << username << " " << password << endl;
        file.close();

        cout << "Registration Successful!\n";
    }

    bool login() {
        string user, pass;
        cout << "\n--- Login ---\n";
        cout << "Username: ";
        cin >> user;
        cout << "Password: ";
        cin >> pass;

        ifstream file("user.txt", ios::in);
        if (!file) {
            cout << "No registered users found.\n";
            return false;
        }

        string fileUser, filePass;
        while (file >> fileUser >> filePass) {
            if (user == fileUser && pass == filePass) {
                cout << "Login Successful! Welcome, " << user << "\n";
                activeUsername = user; // Store active user
                file.close();
                return true;
            }
        }

        cout << "Login Failed: Invalid credentials.\n";
        file.close();
        return false;
    }

    // Save encrypted secret to the logged-in user's file
    void saveSecret() {
        string key;
        string plainText;

        cout << "\nEnter string key for encryption: ";
        cin >> key;
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); // Clear newline buffer

        cout << "Enter text/details to encrypt: ";
        getline(cin, plainText);

        string encryptedText = Encrypt(plainText, key);

        // Open specific file for this logged-in user: vault_<username>.txt
        string fileName = "vault_" + activeUsername + ".txt";
        ofstream vaultFile(fileName, ios::app);
        
        if (vaultFile.is_open()) {
            vaultFile << encryptedText << endl;
            vaultFile.close();
            cout << "Encrypted data successfully saved to " << fileName << "!\n";
        } else {
            cout << "Error opening file to save data.\n";
        }
    }

    // Read and decrypt secrets from the logged-in user's file
    void loadSecrets() {
        string key;
        cout << "\nEnter string key for decryption: ";
        cin >> key;
        cin.ignore(numeric_limits<streamsize>::max(), '\n'); // Clear newline buffer

        string fileName = "vault_" + activeUsername + ".txt";
        ifstream vaultFile(fileName, ios::in);

        if (!vaultFile) {
            cout << "No saved encrypted data found for user '" << activeUsername << "'.\n";
            return;
        }

        string encryptedLine;
        cout << "\n--- Decrypted Vault Items for " << activeUsername << " ---\n";
        int count = 1;
        while (getline(vaultFile, encryptedLine)) {
            if (!encryptedLine.empty()) {
                string decryptedText = Decrypt(encryptedLine, key);
                cout << count++ << ". " << decryptedText << endl;
            }
        }
        vaultFile.close();
    }
};

int main() {
    User userSystem;
    int mainChoice;

    do {
        cout << "\n==========================================" << endl;
        cout << "          SECURE DATA VAULT               " << endl;
        cout << "==========================================" << endl;
        cout << "1. Register" << endl;
        cout << "2. Login" << endl;
        cout << "3. Exit" << endl;
        cout << "Choose an option: ";

        if (!(cin >> mainChoice)) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        if (mainChoice == 1) {
            userSystem.registerUser();
        } 
        else if (mainChoice == 2) {
            if (userSystem.login()) {
                int dashboardChoice;
                do {
                    cout << "\n===== User Dashboard =====\n";
                    cout << "1. Encrypt and Save New Secret\n";
                    cout << "2. View & Decrypt My Saved Secrets\n";
                    cout << "3. Logout\n";
                    cout << "Enter choice: ";

                    if (!(cin >> dashboardChoice)) {
                        cin.clear();
                        cin.ignore(numeric_limits<streamsize>::max(), '\n');
                        continue;
                    }

                    if (dashboardChoice == 1) {
                        userSystem.saveSecret();
                    } else if (dashboardChoice == 2) {
                        userSystem.loadSecrets();
                    } else if (dashboardChoice == 3) {
                        cout << "Logging out...\n";
                    } else {
                        cout << "Invalid choice!\n";
                    }

                } while (dashboardChoice != 3);
            }
        }

    } while (mainChoice != 3);

    cout << "Goodbye!\n";
    return 0;
}
